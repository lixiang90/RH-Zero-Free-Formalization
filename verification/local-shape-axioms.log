'ZeroFree.LocalShape.finite_weighted_exclusion' depends on axioms: [propext, Classical.choice, Quot.sound]
@ZeroFree.LocalShape.finite_weighted_exclusion : ∀ {ι : Type u_1} (anchors : Finset ι) (weight budget : ι → ℝ)
  (kernel : ι → ℝ → ℝ → ℝ) {IsZero : ℝ → ℝ → Prop} {beta t : ℝ},
