'ZeroFree.LocalShape.finite_weighted_kernel_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
@ZeroFree.LocalShape.finite_weighted_kernel_bound : ∀ {ι : Type u_1} (anchors : Finset ι) (weight value budget : ι → ℝ),
  (∀ j ∈ anchors, 0 ≤ weight j) →
    (∀ j ∈ anchors, value j ≤ budget j) → ∑ j ∈ anchors, weight j * value j ≤ ∑ j ∈ anchors, weight j * budget j
