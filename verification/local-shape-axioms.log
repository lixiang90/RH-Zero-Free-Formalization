'ZeroFree.LocalShape.finite_weighted_pair_exclusion' depends on axioms: [propext, Classical.choice, Quot.sound]
@ZeroFree.LocalShape.finite_weighted_pair_exclusion : ∀ {ι : Type u_1} (anchors : Finset ι)
  (weight budget sigma height : ι → ℝ) {IsZero : ℝ → ℝ → Prop} {beta t : ℝ},
  (∀ j ∈ anchors, 0 ≤ weight j) →
    ∑ j ∈ anchors, weight j * budget j <
        ∑ j ∈ anchors, weight j * ZeroFree.LocalShape.anchoredPairKernel (sigma j) (height j) beta t →
      (IsZero beta t → ∀ j ∈ anchors, ZeroFree.LocalShape.anchoredPairKernel (sigma j) (height j) beta t ≤ budget j) →
        ¬IsZero beta t
