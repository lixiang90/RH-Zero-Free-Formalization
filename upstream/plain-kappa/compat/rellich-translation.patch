   -- Reduce to the standard `fderiv` translation lemma.
-  simpa [translate] using (fderiv_comp_add_right (𝕜 := ℝ) (f := f) (x := x) a)
+  exact congrArg (InnerProductSpace.toDual ℝ E).symm
+    (fderiv_comp_add_right (𝕜 := ℝ) (f := f) (x := x) a)
 
