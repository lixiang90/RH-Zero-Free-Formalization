 lemma grad_translate (a : E) (f : E → ℝ) (x : E) :
     grad (E := E) (translate (E := E) a f) x = grad (E := E) f (x + a) := by
   classical
   -- `fderiv` commutes with translation, hence so does `grad`.
-  simp [grad]
+  change (InnerProductSpace.toDual ℝ E).symm (fderiv ℝ (fun y => f (y + a)) x) =
